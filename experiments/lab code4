#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char plaintext[100], key[100], ciphertext[100];
    int i, j = 0;

    printf("Enter Plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Enter Key: ");
    scanf("%s", key);

    int keyLen = strlen(key);

    for (i = 0; plaintext[i] != '\0'; i++) {
        char ch = plaintext[i];

        if (isalpha(ch)) {
            int shift = toupper(key[j % keyLen]) - 'A';

            if (isupper(ch))
                ciphertext[i] = ((ch - 'A' + shift) % 26) + 'A';
            else
                ciphertext[i] = ((ch - 'a' + shift) % 26) + 'a';

            j++;
        }
        else {
            ciphertext[i] = ch;
        }
    }

    ciphertext[i] = '\0';

    printf("Ciphertext: %s", ciphertext);

    return 0;
}
