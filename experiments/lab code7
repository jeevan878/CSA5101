#include <stdio.h>
#include <string.h>

int main() {
    char cipher[1000];

    printf("Enter Ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    for (int i = 0; cipher[i] != '\0'; i++) {

        if (cipher[i] == '8')
            cipher[i] = 'E';
        else if (cipher[i] == ';')
            cipher[i] = 'T';
        else if (cipher[i] == '4')
            cipher[i] = 'H';
        else if (cipher[i] == ')')
            cipher[i] = 'S';
        else if (cipher[i] == '*')
            cipher[i] = 'N';
        else if (cipher[i] == '5')
            cipher[i] = 'A';
        else if (cipher[i] == '6')
            cipher[i] = 'I';
    }

    printf("\nPartially Decrypted Text:\n%s", cipher);

    return 0;
}
