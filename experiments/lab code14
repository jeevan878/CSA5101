#include <stdio.h>

// Find multiplicative inverse modulo 26
int modInverse(int a) {
    a %= 26;
    for (int x = 1; x < 26; x++) {
        if ((a * x) % 26 == 1)
            return x;
    }
    return -1;
}

int main() {
    int P[2][2], C[2][2];
    int det, detInv;
    int PInv[2][2];
    int K[2][2];

    printf("Enter Plaintext Matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &P[i][j]);

    printf("Enter Ciphertext Matrix (2x2):\n");
    for (int i = 0; i < 2; i++)
        for (int j = 0; j < 2; j++)
            scanf("%d", &C[i][j]);

    // Determinant of P
    det = (P[0][0] * P[1][1] - P[0][1] * P[1][0]) % 26;
    if (det < 0)
        det += 26;

    detInv = modInverse(det);

    if (detInv == -1) {
        printf("Plaintext matrix is not invertible.\n");
        return 0;
    }

    // Inverse of P modulo 26
    PInv[0][0] = ( P[1][1] * detInv) % 26;
    PInv[0][1] = ((-P[0][1] + 26) * detInv) % 26;
    PInv[1][0] = ((-P[1][0] + 26) * detInv) % 26;
    PInv[1][1] = ( P[0][0] * detInv) % 26;

    // Recover key K = C × P⁻¹ mod 26
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++) {
            K[i][j] =
                (C[i][0] * PInv[0][j] +
                 C[i][1] * PInv[1][j]) % 26;
        }
    }

    printf("\nRecovered Key Matrix:\n");
    for (int i = 0; i < 2; i++) {
        for (int j = 0; j < 2; j++)
            printf("%d ", K[i][j]);
        printf("\n");
    }

    return 0;
}
