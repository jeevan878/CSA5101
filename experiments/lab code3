#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

// Generate Playfair Matrix
void generateMatrix(char key[]) {
    int used[26] = {0};
    int row = 0, col = 0;

    used['J' - 'A'] = 1; // I and J treated as same

    for (int i = 0; key[i] != '\0'; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';

        if (!used[ch - 'A']) {
            matrix[row][col++] = ch;
            used[ch - 'A'] = 1;

            if (col == 5) {
                row++;
                col = 0;
            }
        }
    }

    for (char ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[row][col++] = ch;

            if (col == 5) {
                row++;
                col = 0;
            }
        }
    }
}

// Find position of character in matrix
void findPosition(char ch, int *r, int *c) {
    if (ch == 'J') ch = 'I';

    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
        }
    }
}

// Encrypt digraphs
void encrypt(char text[]) {
    int len = strlen(text);

    for (int i = 0; i < len; i += 2) {
        int r1, c1, r2, c2;

        findPosition(text[i], &r1, &c1);
        findPosition(text[i + 1], &r2, &c2);

        if (r1 == r2) { // Same row
            text[i]     = matrix[r1][(c1 + 1) % 5];
            text[i + 1] = matrix[r2][(c2 + 1) % 5];
        }
        else if (c1 == c2) { // Same column
            text[i]     = matrix[(r1 + 1) % 5][c1];
            text[i + 1] = matrix[(r2 + 1) % 5][c2];
        }
        else { // Rectangle rule
            text[i]     = matrix[r1][c2];
            text[i + 1] = matrix[r2][c1];
        }
    }

    printf("Cipher Text: %s\n", text);
}

int main() {
    char key[50], text[100];

    printf("Enter keyword: ");
    scanf("%s", key);

    printf("Enter plaintext (even number of letters): ");
    scanf("%s", text);

    for (int i = 0; text[i]; i++)
        text[i] = toupper(text[i]);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    encrypt(text);

    return 0;
}
