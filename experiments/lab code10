#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5] = {
    {'M','F','H','I','K'},
    {'U','N','O','P','Q'},
    {'Z','V','W','X','Y'},
    {'E','L','A','R','G'},
    {'D','S','T','B','C'}
};

void findPos(char ch, int *row, int *col) {
    if (ch == 'J')
        ch = 'I';

    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

int main() {
    char text[100], prepared[100];
    int i, j = 0;

    printf("Enter Plaintext: ");
    fgets(text, sizeof(text), stdin);

    // Remove spaces and convert to uppercase
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            prepared[j++] = toupper(text[i]);
        }
    }

    // Add X if length is odd
    if (j % 2 != 0) {
        prepared[j++] = 'X';
    }

    prepared[j] = '\0';

    printf("Cipher Text: ");

    for (i = 0; i < j; i += 2) {
        int r1, c1, r2, c2;

        findPos(prepared[i], &r1, &c1);
        findPos(prepared[i + 1], &r2, &c2);

        if (r1 == r2) {
            printf("%c%c",
                   matrix[r1][(c1 + 1) % 5],
                   matrix[r2][(c2 + 1) % 5]);
        }
        else if (c1 == c2) {
            printf("%c%c",
                   matrix[(r1 + 1) % 5][c1],
                   matrix[(r2 + 1) % 5][c2]);
        }
        else {
            printf("%c%c",
                   matrix[r1][c2],
                   matrix[r2][c1]);
        }
    }

    printf("\n");
    return 0;
}
