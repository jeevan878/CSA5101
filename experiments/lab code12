#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    int key[2][2] = {{9, 4}, {5, 7}};
    char text[100];

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    char plain[100];
    int k = 0;

    // Remove spaces and convert to lowercase
    for (int i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            plain[k++] = tolower(text[i]);
        }
    }

    // Add padding if odd length
    if (k % 2 != 0)
        plain[k++] = 'x';

    plain[k] = '\0';

    printf("Ciphertext: ");

    for (int i = 0; i < k; i += 2) {
        int p1 = plain[i] - 'a';
        int p2 = plain[i + 1] - 'a';

        int c1 = (key[0][0] * p1 + key[0][1] * p2) % 26;
        int c2 = (key[1][0] * p1 + key[1][1] * p2) % 26;

        printf("%c%c", c1 + 'a', c2 + 'a');
    }

    printf("\n");

    return 0;
}
