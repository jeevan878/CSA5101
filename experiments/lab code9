#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

// Find position of a character in matrix
void findPos(char ch, int *row, int *col) {
    if (ch == 'J')
        ch = 'I';

    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

// Generate Playfair matrix
void generateMatrix(char key[]) {
    int used[26] = {0};
    used['J' - 'A'] = 1;

    int r = 0, c = 0;

    for (int i = 0; key[i]; i++) {
        char ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A']) {
            matrix[r][c++] = ch;
            used[ch - 'A'] = 1;

            if (c == 5) {
                r++;
                c = 0;
            }
        }
    }

    for (char ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[r][c++] = ch;

            if (c == 5) {
                r++;
                c = 0;
            }
        }
    }
}

// Decrypt Playfair text
void decrypt(char text[]) {
    int len = strlen(text);

    for (int i = 0; i < len; i += 2) {
        int r1, c1, r2, c2;

        findPos(text[i], &r1, &c1);
        findPos(text[i + 1], &r2, &c2);

        if (r1 == r2) {
            text[i]     = matrix[r1][(c1 + 4) % 5];
            text[i + 1] = matrix[r2][(c2 + 4) % 5];
        }
        else if (c1 == c2) {
            text[i]     = matrix[(r1 + 4) % 5][c1];
            text[i + 1] = matrix[(r2 + 4) % 5][c2];
        }
        else {
            text[i]     = matrix[r1][c2];
            text[i + 1] = matrix[r2][c1];
        }
    }

    printf("\nPlaintext:\n%s\n", text);
}

int main() {
    char key[] = "ROYALNEWZEALANDNAVY";

    char cipher[] =
        "KXJEYUREBEZWEHEWRYTUHEYFS"
        "KREHEGOYFIWTTTUOLKSYCAJPO"
        "BOTEIZONTXBYBNTGONEYCUZWR"
        "GDSONSXBOUYWRHEBAAHYUSEDQ";

    generateMatrix(key);

    decrypt(cipher);

    return 0;
}
