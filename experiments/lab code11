#include <stdio.h>

long double factorial(int n) {
    long double fact = 1;

    for (int i = 2; i <= n; i++)
        fact *= i;

    return fact;
}

int main() {
    long double keys = factorial(25);

    printf("Total possible Playfair keys (25!) = %.0Lf\n", keys);
    printf("Approximate power of 2 = 2^84\n");

    return 0;
}
