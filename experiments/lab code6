#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char cipher[200];

    int a_inv = 21; // inverse of 5 mod 26
    int b = 7;

    printf("Enter Ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    for (int i = 0; cipher[i] != '\0'; i++) {
        if (isupper(cipher[i])) {
            int c = cipher[i] - 'A';
            int p = (a_inv * ((c - b + 26) % 26)) % 26;
            cipher[i] = p + 'A';
        }
        else if (islower(cipher[i])) {
            int c = cipher[i] - 'a';
            int p = (a_inv * ((c - b + 26) % 26)) % 26;
            cipher[i] = p + 'a';
        }
    }

    printf("Decrypted Text: %s", cipher);

    return 0;
}
